# ─────────────────────────────────────────────────────────────
# MarkazOS environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Database — Hostinger Web/Cloud hosting runs MariaDB on port 3306.
# Prisma's `mysql` provider is wire-compatible with MariaDB.
#
# Where to find these: hPanel → Databases → Databases → Create new database.
#
# ⚠️ The host MUST be the MySQL hostname hPanel shows you (e.g. srv1517.hstgr.io),
#    NOT `localhost`. Node.js resolves `localhost` to the IPv6 loopback and
#    connects over TCP, which the database user is not granted for → "connection
#    refused". PHP apps may use localhost; Node.js apps must not.
# ⚠️ Also add the server's IP under hPanel → Databases → Remote MySQL, otherwise
#    the connection is blocked.
# ⚠️ `connection_limit` caps the pool. Shared hosting allows few concurrent
#    connections, so keep it low (5 is safe).
DATABASE_URL="mysql://u1234567890_markazos:YOUR_PASSWORD@srv1234.hstgr.io:3306/u1234567890_markazos?connection_limit=5"

# Auth — generate a long random secret, e.g.:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret-string"

# Session lifetime (seconds) — default 7 days
SESSION_TTL="604800"

# Public app URL. NEXT_PUBLIC_* values are INLINED AT BUILD TIME, so this must be
# set in the Hostinger app settings *before* the first deploy, or the change
# requires another rebuild.
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Optional integrations (server-side only — never expose to the client)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# ─────────────────────────────────────────────────────────────
# Deploying to Supabase/Postgres instead?
# The schema uses plain strings for enums, so it is database-agnostic. Set
# provider = "postgresql" in prisma/schema.prisma, add `directUrl = env("DIRECT_URL")`,
# and use the pooled URL for runtime plus the direct URL for migrations.
# ─────────────────────────────────────────────────────────────
